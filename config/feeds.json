{
  "version": 2,
  "_readme": [
    "NewsPulse feed registry. Consumed by scripts/fetch_feeds.py.",
    "category: one of the 10 site categories in config/site-config.json:",
    "world, india, tech, business, sports, gaming, music, movies, science, entertainment.",
    "strip_source_suffix: true for Google News feeds whose titles end with ' - Publisher'.",
    "Per-feed overrides: max_items, timeout_seconds, user_agent.",
    "Global settings: settings.timeout_seconds, settings.max_items_per_feed,",
    "settings.description_max_chars, settings.retries, settings.user_agent (optional)."
  ],
  "settings": {
    "timeout_seconds": 10,
    "max_items_per_feed": 25,
    "description_max_chars": 500,
    "retries": 1
  },
